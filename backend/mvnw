# Maven Wrapper script
MAVEN_WRAPPER_VERSION=3.2.0

# Base directory for the project
basedir=`dirname "$(readlink -f "$0")"`

# OS detection
case "`uname`" in
  CYGWIN*) cygwin=true ;;
  MINGW*) mingw=true;;
  Darwin*) darwin=true
    if [ -z "$JAVA_VERSION" ] ; then
      JAVA_VERSION="CurrentJDK"
    else
      echo "Using Java version: $JAVA_VERSION"
    fi
    ;;
  *) darwin=false ;;
esac

if [ -z "$MAVEN_PROJECTBASEDIR" ] ; then
  MAVEN_PROJECTBASEDIR="$basedir"
  [ -r "$basedir/.mvn/wrapper/maven-wrapper.properties" ] &&
  . "$basedir/.mvn/wrapper/maven-wrapper.properties"
fi

MAVEN_WRAPPER_JAR_PATH="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_LAUNCHER_CLASS="org.apache.maven.wrapper.MavenWrapperMain"

exec java $MAVEN_OPTS \
  -classpath "$MAVEN_WRAPPER_JAR_PATH" \
  "-Dmaven.multiModuleProjectDirectory=${MAVEN_PROJECTBASEDIR}" \
  $MAVEN_WRAPPER_LAUNCHER_CLASS "$@"